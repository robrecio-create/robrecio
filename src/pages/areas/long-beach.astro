    margin: 3rem auto 0;
    padding: 1.6rem 1.8rem;
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .sources h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.8rem;
  }
  .sources ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }
  .sources li {
    font-size: 0.92rem;
    color: var(--ink-soft);
    padding: 0.35rem 0;
    border-bottom: 1px dashed var(--line-strong);
  }
  .sources li:last-child { border-bottom: none; }
  .sources-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    margin: 0;
  }
</style>
