  .cta-block h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.8rem;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }
  .cta-block p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-buttons {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .cta-note {
    font-size: 0.82rem !important;
    color: var(--ink-soft) !important;
    font-style: italic;
    margin-bottom: 0 !important;
