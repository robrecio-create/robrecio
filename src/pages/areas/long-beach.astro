---
import SiteLayout from '../../layouts/SiteLayout.astro';

// Image slots — flip null → '/areas/long-beach/<file>.jpg' when Rob delivers the shot.
// Keep paths even when null so the shot list stays visible inline as code comments.
const hero = {
  image: null, // '/areas/long-beach/hero.jpg' — the beach along Highway 90 with the Long Beach Harbor in frame, USM Gulf Park's oaks in the background
  alt: 'The Long Beach, Mississippi beachfront along Highway 90, with the small-craft harbor and the live oaks of the USM Gulf Park campus behind it.',
};

const neighborhoods = [
  {
    code: 'BEACH BLOCKS',
    name: 'South of the tracks — Beach Boulevard to the railroad',
    walk: 'Walk-to-sand, elevated construction',
    blurb: 'The Highway 90 beachfront and the first blocks behind it. Katrina leveled this stretch in 2005, so what stands today is largely post-storm elevated construction — the same story as the rest of the beachfront Coast, with the harbor and the USM campus as the landmarks.',
    detail: 'VE/AE flood zones dominate here — flood insurance required with a mortgage, and the three-policy stack applies. Post-2011 builds insure cleanest; get the elevation certificate.',
    image: null, // '/areas/long-beach/beach-blocks.jpg' — an elevated home near the beachfront south of the tracks
    imageAlt: 'An elevated post-Katrina home in the beach blocks of Long Beach, south of the railroad tracks.',
  },
  {
    code: 'IN-TOWN CORE',
    name: 'Central Long Beach — Town Green, schools, and the grid',
    walk: 'Bike-to-everything, family core',
    blurb: 'The heart of the Friendly City: established neighborhoods around Harper McCaughan Town Green, Jeff Davis Avenue\'s small downtown, and the school campuses. This is where the walk-to-Friday-night-lights life happens, and it\'s the most contested stock in town because of the district.',
    detail: 'Flood zones vary block to block — AE near the drainage bayous, X on the higher lots. Verify the specific parcel; two houses on the same street can carry very different insurance math.',
    image: null, // '/areas/long-beach/in-town.jpg' — a residential street near the Town Green
    imageAlt: 'A residential street in central Long Beach near Harper McCaughan Town Green.',
  },
  {
    code: 'NORTH LONG BEACH',
    name: 'North of Pass Road toward I-10',
    walk: 'Suburban, newer builds, higher ground',
    blurb: 'Subdivisions and larger lots as you move north — much of the newer construction sits up here, still zoned to the same district that has families moving across county lines.',
    detail: 'X zones get common as you go north, which means the friendliest insurance math in town. The trade is a 5–10 minute drive to the sand instead of a walk.',
    image: null, // '/areas/long-beach/north.jpg' — a newer subdivision street in north Long Beach
    imageAlt: 'A newer subdivision street in north Long Beach, north of Pass Road.',
  },
];

const schools = [
  { level: 'District', name: 'Long Beach School District — rated A and ranked #1 in Mississippi in the 2025 MDE accountability results (794 points)' },
  { level: 'Highlights', name: '95.7% graduation rate · all three elementary schools A-rated in 2025' },
  { level: 'Ratings', name: 'Annual accountability ratings published at mdek12.org — verify the current year before you buy on a rating' },
];

const marketBeats = [
  {
    label: 'The school district is the moat',
    value: 'In 2025 the Long Beach School District posted the highest accountability score of any district in Mississippi. Districts move around year to year, but Long Beach has been at or near the top for a long stretch — and that reputation is priced into the housing, holds values in soft markets, and pulls families from across Harrison County.',
  },
  {
    label: 'USM Gulf Park is a quiet anchor',
    value: 'A 52-acre university campus on the beachfront — under the Friendship Oak — brings faculty, staff, students, and events. College-town energy at one-tenth college-town scale, and a steady rental and resale audience most beach towns don\'t have.',
  },
  {
    label: 'Family town first, beach town second',
    value: 'Long Beach reads different from Biloxi or even Ocean Springs: no casino strip, modest downtown, big youth-sports culture. Buyers chasing nightlife look elsewhere; buyers chasing a yard, a district, and a beach 10 minutes away look here.',
  },
  {
    label: 'Build era is everything south of the tracks',
    value: 'The beachfront blocks were essentially erased in 2005. Post-2011-maps elevated construction insures dramatically better than surviving pre-storm slab homes — the gap shows up in premiums, financing ease, and resale.',
  },
  {
    label: 'Talk to Rob signal',
    value: 'Families comparing Long Beach vs. Ocean Springs vs. Pass Christian on schools, and buyers trying to decide whether the beach-block insurance stack is worth it vs. an X-zone lot in-town. I\'ll run both sets of numbers with you straight.',
  },
];
---

<SiteLayout
  title="Long Beach, MS — Coast Area Guide | Rob Recio"
  description="A plain-talk Long Beach area guide — the Friendly City's #1-in-Mississippi school district, USM Gulf Park, the harbor, flood reality, prices, and who buys here."
  robots="index, follow"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow">Coast Areas · Harrison County</p>
      <h1>Long Beach, <em>the Friendly City.</em></h1>

      <aside class="pre-license-banner" role="note" aria-label="Pre-licensure notice">
        <p><strong>Heads up.</strong> I'm a licensed Mississippi real estate salesperson (License #S-62221) with Real Broker, LLC. This page is general information about living on the Coast — not a property-specific opinion, legal or tax advice, or an insurance determination. When you're ready to talk specifics, I'm here to help.</p>
      </aside>

      <p class="lede">Long Beach calls itself "The Friendly City," and it's the Coast's clearest family-first beach town: about 15,000 people, a quiet stretch of sand, a small-craft harbor, a university campus under a 500-year-old oak — and <strong>the school district that ranked #1 in the entire state of Mississippi in the 2025 accountability results</strong>. If the question is "where do families with school-age kids buy on the Coast," Long Beach is always in the first breath of the answer.</p>
    </header>

    {hero.image && (
      <figure class="hero-figure">
        <img src={hero.image} alt={hero.alt} loading="eager" width="1440" height="810" />
      </figure>
    )}

    <section class="guide-section">
      <h2>The town in one paragraph</h2>
      <p>Long Beach sits in Harrison County between Pass Christian and Gulfport, with Highway 90 running along its beachfront and the CSX railroad tracks drawing the historical line between beach blocks and the town proper. The identity here is residential on purpose — no casinos, a modest downtown around the Harper McCaughan Town Green, a working small-craft harbor, and the University of Southern Mississippi's Gulf Park campus spread over 52 beachfront acres of live oaks. Katrina hit the beachfront hard in 2005 (this stretch took 20-plus feet of surge), and the blocks south of the tracks rebuilt elevated and storm-rated. But the thing that actually organizes the market is the school district: Long Beach schools are the town's brand, its price support, and the reason a meaningful share of buyers never look anywhere else.</p>
    </section>

    <section class="guide-section">
      <h2>The areas of town</h2>
      <p class="section-sub">Long Beach splits roughly into the beach blocks south of the tracks, the in-town core around the Town Green and schools, and the newer, higher ground north toward I-10. Each carries a different price band and a different flood and insurance profile.</p>

      <div class="zone-grid neighborhood-grid">
        {neighborhoods.map(n => (
          <div class="zone-card">
            {n.image && (
              <div class="zone-card-image">
                <img src={n.image} alt={n.imageAlt} loading="lazy" width="800" height="500" />
              </div>
            )}
            <div class="zone-card-body">
              <div class="zone-code">{n.code}</div>
              <h3>{n.name}</h3>
              <p class="walk-tag">{n.walk}</p>
              <p class="zone-blurb">{n.blurb}</p>
              <p class="zone-detail">{n.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="callout"><strong>On prices.</strong> Directional, mid-2020s — verify against current MLS. Recent market reports put Long Beach's median sale price around the <strong>high $200Ks</strong> (roughly $295K in spring 2026, up double digits year over year), with in-town family homes commonly $220K–$350K and elevated beach-block and harbor-view homes running well above that. The district premium is real: comparable square footage often costs less one town over — that's the tuition you're prepaying.</p>
    </section>

    <section class="guide-section">
      <h2>Schools — the headline here</h2>
      <p>This is the rare Coast town where the schools section leads. In the Mississippi Department of Education's 2025 accountability results, the <strong>Long Beach School District earned an A rating and the highest district score in the state</strong> — 794 points, with a 95.7% graduation rate and all three elementary schools rated A. Ratings are re-issued every fall; verify the current year at <a href="https://www.mdek12.org/" target="_blank" rel="noopener">mdek12.org</a> and confirm the attendance zone for any specific address with the district.</p>

      <div class="school-grid">
        {schools.map(s => (
          <div class="school-row">
            <span class="school-level">{s.level}</span>
            <span class="school-name">{s.name}</span>
          </div>
        ))}
      </div>

      <p class="school-note">Private and parochial options in neighboring Gulfport and Pass Christian round out the picture. Verify current programs, grades served, and admissions directly with each school.</p>
    </section>

    <section class="guide-section">
      <h2>Flood profile, in plain terms</h2>
      <p>The pattern matches the rest of the open-coast Harrison County beachfront: VE and AE zones dominate south of the railroad tracks, where Katrina's surge did its worst, and the stock there is now mostly elevated post-storm construction. Move north through town and X zones become common — north Long Beach has some of the friendliest insurance math on the beachfront Coast.</p>
      <p>Pull the FIRM panel at <a href="https://msc.fema.gov" target="_blank" rel="noopener">msc.fema.gov</a> for any address, and read my <a href="/guides/coastal-ms-flood-zones">flood-zone guide</a> before you shop. If you're buying south of the tracks, the three-policy insurance stack applies — my <a href="/guides/wind-and-flood-insurance">wind &amp; flood insurance guide</a> walks through the whole thing, named-storm deductibles included.</p>
    </section>

    <section class="guide-section">
      <h2>Market beats every Long Beach buyer or seller should hear</h2>
      <p class="section-sub">Stable patterns — not month-to-month price talk. These are the things that come up in every real Long Beach conversation.</p>

      <dl class="beats">
        {marketBeats.map(b => (
          <div class="beat">
            <dt>{b.label}</dt>
            <dd>{b.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="guide-section">
      <h2>Day-to-day in Long Beach</h2>
      <p>Stuff that's actually here, in case you're trying to picture life on the ground:</p>
      <ul class="bullets">
        <li><strong>The beach:</strong> a quiet stretch of the 26-mile sand beach along Highway 90 — calm Sound water, no commercial strip behind it.</li>
        <li><strong>Long Beach Harbor:</strong> a working small-craft harbor and marina with overnight and long-term slips — designated a Clean and Resilient Marina.</li>
        <li><strong>Harper McCaughan Town Green:</strong> the town's front porch — stage, splash pad, oak shade, festivals and markets.</li>
        <li><strong>USM Gulf Park:</strong> the 52-acre beachfront campus, home of the Friendship Oak — a live oak roughly 500 years old — plus lectures, events, and continuing education.</li>
        <li><strong>Day-trip math:</strong> Pass Christian 10 minutes · Gulfport (airport, hospitals, big-box) 15 · Biloxi 25 · Bay St. Louis 20 · New Orleans about 75 minutes.</li>
      </ul>
    </section>

    <section class="guide-section">
      <h2>Who tends to buy here</h2>
      <p>The Long Beach buyer pool I see breaks down roughly like this:</p>
      <ul class="bullets">
        <li><strong>Families chasing the district</strong> — the biggest pipeline by far, including moves from elsewhere on the Coast.</li>
        <li><strong>Relocators doing school-first searches</strong> from out of state (<a href="/relocation">relocation guide</a>).</li>
        <li><strong>Gulfport and Stennis-corridor commuters</strong> who want the small-town read with a 15-minute drive.</li>
        <li><strong>Retirees</strong> who want beach quiet with more town than Waveland and less bustle than Biloxi (<a href="/guides/retiring-on-the-ms-gulf-coast">retirement guide</a>).</li>
      </ul>
    </section>

    <section class="cta-block">
      <h2>Thinking about Long Beach?</h2>
      <p>Whether you're comparing districts, weighing beach-block insurance against an in-town X-zone lot, or trying to time a sale in a town where inventory moves fast — happy to talk it through straight.</p>
      <div class="cta-buttons">
        <a href="tel:+12283251502" class="btn btn-primary">Call or text Rob — (228) 325-1502</a>
        <a href="mailto:rob@robrecio.com" class="btn btn-ghost">Email Rob</a>
      </div>
      <p class="cta-note">Rob Recio is a licensed Mississippi real estate salesperson (#S-62221) with Real Broker, LLC. This guide is general information about Long Beach as a place to live — not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Sources & cross-links</h3>
      <ul>
        <li>MDE 2025 accountability ratings — <a href="https://mdek12.org/publicreporting/2025-accountability/" target="_blank" rel="noopener">mdek12.org</a> · WLOX coverage of Long Beach ranking #1 (Sept 2025)</li>
        <li>USM Gulf Park campus — <a href="https://www.usm.edu/gulf-park/index.php" target="_blank" rel="noopener">usm.edu/gulf-park</a></li>
        <li>City & heritage profile — <a href="https://msgulfcoastheritage.ms.gov/long-beach/" target="_blank" rel="noopener">msgulfcoastheritage.ms.gov</a></li>
        <li>FEMA Map Service Center — <a href="https://msc.fema.gov" target="_blank" rel="noopener">msc.fema.gov</a></li>
        <li>Market data: Redfin Long Beach MS housing-market report (2025–26)</li>
        <li>Related on this site: <a href="/areas/pass-christian">Pass Christian guide</a> · <a href="/areas/gulfport">Gulfport guide</a> · <a href="/guides/coastal-ms-flood-zones">Flood zones</a> · <a href="/guides/wind-and-flood-insurance">Wind &amp; flood insurance</a> · <a href="/relocation">Relocation guide</a></li>
      </ul>
      <p class="sources-note"><strong>Drafted July 2026.</strong> Prices, ordinances, ratings change — verify before relying on a number. Next refresh: after 2026–27 accountability ratings.</p>
    </aside>

  </main>

</SiteLayout>

<style>
  .guide {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .guide-hero {
    max-width: var(--max-prose);
    margin: 0 auto 4rem;
    text-align: left;
  }
  .eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gulf);
    margin-bottom: 1.2rem;
  }
  .guide-hero h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 4.8vw, 3.4rem);
    line-height: 1.07;
    letter-spacing: -0.022em;
    color: var(--ink);
  }
  .guide-hero h1 em {
    font-style: italic;
    color: var(--gulf-deep);
  }
  .pre-license-banner {
    margin-top: 1.6rem;
    padding: 1rem 1.3rem;
    background: var(--sand);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
  }
  .pre-license-banner p {
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  .pre-license-banner strong { color: var(--ink); }
  .lede {
    font-size: 1.18rem;
    color: var(--ink-soft);
    margin-top: 1.5rem;
    line-height: 1.6;
  }
  .lede strong { color: var(--ink); }

  .guide-section {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .guide-section h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-bottom: 1.2rem;
  }
  .guide-section p {
    font-size: 1.06rem;
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
    line-height: 1.7;
  }
  .guide-section p:first-of-type { color: var(--ink); }
  .guide-section .section-sub {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-top: -0.4rem;
    margin-bottom: 1.8rem;
  }

  .bullets {
    margin: 0 0 1.2rem 0;
    padding-left: 1.4rem;
    color: var(--ink-soft);
  }
  .bullets li {
    margin-bottom: 0.85rem;
    line-height: 1.65;
  }
  .bullets li strong { color: var(--ink); }

  .callout {
    background: var(--sand);
    border-left: 3px solid var(--gulf);
    padding: 1.1rem 1.3rem;
    border-radius: 0 8px 8px 0;
    font-size: 0.98rem !important;
    color: var(--ink) !important;
    margin-top: 1.2rem;
  }
  .callout strong { color: var(--gulf-deep); }

  /* Hero figure — full prose-max width, just under the lede */
  .hero-figure {
    max-width: var(--max);
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Inline figures — single wide, or 2-up grid */
  .inline-figure {
    margin: 1.5rem 0 0.4rem;
  }
  .inline-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .inline-figure-wide img {
    aspect-ratio: 16 / 9;
  }
  .inline-figure figcaption {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    margin-top: 0.45rem;
    text-align: center;
  }
  .inline-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .inline-pair .inline-figure {
    margin: 0;
  }
  @media (max-width: 640px) {
    .inline-pair { grid-template-columns: 1fr; }
  }

  /* Neighborhood grid — 2-up on desktop, 1-up mobile */
  .neighborhood-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .zone-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .zone-card-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .zone-card-body {
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
  }
  .zone-code {
    display: inline-block;
    background: var(--gulf);
    color: var(--paper);
    font-family: var(--serif);
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 6px;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    margin-bottom: 0.7rem;
    align-self: flex-start;
  }
  .zone-card h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.22rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .walk-tag {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem !important;
    color: var(--gulf-deep) !important;
    margin-bottom: 0.7rem !important;
  }
  .zone-blurb {
    font-size: 0.97rem !important;
    color: var(--ink) !important;
    margin-bottom: 0.7rem !important;
    line-height: 1.55 !important;
  }
  .zone-detail {
    font-size: 0.92rem !important;
    color: var(--ink-soft) !important;
    line-height: 1.55 !important;
    margin-bottom: 0 !important;
  }
  @media (max-width: 760px) {
    .neighborhood-grid { grid-template-columns: 1fr; }
  }

  /* Schools — simple row layout */
  .school-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1.2rem 0 1rem;
    padding: 1.2rem 1.4rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .school-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .school-level {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--gulf);
  }
  .school-name {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .school-note {
    font-size: 0.92rem !important;
    color: var(--ink-soft) !important;
    font-style: italic;
  }
  @media (max-width: 560px) {
    .school-row { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  /* Market beats — definition list */
  .beats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.2rem;
  }
  .beat {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--gulf);
    border-radius: 0 10px 10px 0;
    padding: 1rem 1.3rem;
  }
  .beat dt {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--gulf-deep);
    margin-bottom: 0.3rem;
  }
  .beat dd {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.6;
  }

  .cta-block {
    max-width: var(--max-prose);
    margin: 4rem auto 0;
    padding: 2.5rem 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-align: center;
