---
import SiteLayout from '../../layouts/SiteLayout.astro';

// Image slots — flip null → '/areas/waveland/<file>.jpg' when Rob delivers the shot.
// Keep paths even when null so the shot list stays visible inline as code comments.
const hero = {
  image: null, // '/areas/waveland/hero.jpg' — Beach Boulevard looking down the residential beachfront, elevated homes on one side, sand on the other
  alt: 'Beach Boulevard in Waveland — elevated homes on pilings facing the Mississippi Sound, with the quiet residential beach across the road.',
};

const neighborhoods = [
  {
    code: 'BEACH BLOCKS',
    name: 'Beach Boulevard and the first blocks in',
    walk: 'Walk-to-sand, elevated construction',
    blurb: 'The signature Waveland setting: elevated homes on pilings facing the Sound, or a block or two back. Nearly everything here is post-2005; much of it post-2011-maps construction that insures relatively cleanly for open-coast property.',
    detail: 'VE/AE zones — flood insurance required with a mortgage, and the three-policy stack applies. Get the elevation certificate; on this stretch it usually helps.',
    image: null, // '/areas/waveland/beach-blocks.jpg' — an elevated home on pilings along Beach Boulevard
    imageAlt: 'An elevated home on pilings along Beach Boulevard in Waveland.',
  },
  {
    code: 'CENTRAL WAVELAND',
    name: 'Central Waveland / Highway 90 corridor',
    walk: 'Drive-short, everyday living',
    blurb: 'The working middle of town — established neighborhoods north of the beach blocks, the Highway 90 commercial strip (the shopping happens here, since the beachfront can’t have it), and a mix of rebuilt and pre-storm homes.',
    detail: 'Flood zones vary block to block; AE is common, with X appearing as you move north. This is where the year-round value sits.',
    image: null, // '/areas/waveland/central.jpg' — an established central Waveland residential street
    imageAlt: 'An established residential street in central Waveland, north of the beach blocks.',
  },
  {
    code: 'NORTH OF I-10 / THE KILN SIDE',
    name: 'North toward the Kiln',
    walk: 'Rural-suburban, highest ground',
    blurb: 'Larger lots, more trees, and the cleanest insurance math in the area as you get north of I-10 toward the Kiln.',
    detail: 'The trade is distance to the sand — 10–15 minutes instead of a walk.',
    image: null, // '/areas/waveland/north.jpg' — a larger-lot rural-suburban street north toward the Kiln
    imageAlt: 'A larger-lot, tree-lined street north of I-10 toward the Kiln.',
  },
];

const schools = [
  { level: 'District', name: 'Bay St. Louis-Waveland School District (shared with Bay St. Louis)' },
  { level: 'Ratings', name: 'Annual accountability ratings published at mdek12.org' },
  { level: 'Private', name: 'Coast Episcopal · Hancock County private/parochial options' },
];

const marketBeats = [
  {
    label: 'The beachfront ordinance is the moat',
    value: 'No commercial development on the sand means the quiet can’t be built away. That protection is worth real money over a holding period, and it’s why Waveland beach blocks trade differently than Biloxi’s.',
  },
  {
    label: 'The New Orleans weekender pipeline',
    value: 'An hour door-to-door makes Waveland/Bay St. Louis the closest true beach-town market to NOLA money. It supports prices, and it means well-presented listings get out-of-state eyes by default.',
  },
  {
    label: 'Build era is everything here',
    value: 'The gap between a post-2011 elevated home and a surviving pre-Katrina slab home — in insurability, financing ease, and resale — is wider in Waveland than almost anywhere on the Coast.',
  },
  {
    label: 'STR check before you buy',
    value: 'Short-term-rental demand exists (beach + NOLA proximity), but verify Waveland’s current ordinance before an STR is the basis of your numbers.',
  },
  {
    label: 'Talk to Rob signal',
    value: 'Second-home shoppers comparing Waveland vs. Bay St. Louis, retirees chasing the no-commercial-beach quiet, and remote workers priced out of Ocean Springs. I’ll tell you straight which side of the Bay St. Louis/Waveland line fits.',
  },
];
---

<SiteLayout
  title="Waveland, MS — Coast Area Guide | Rob Recio"
  description="A plain-talk Waveland area guide — the only Coast town with no commercial buildings on its beachfront, post-Katrina construction, flood reality, and who buys here."
  robots="index, follow"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow">Coast Areas · Hancock County</p>
      <h1>Waveland, <em>the quiet beachfront.</em></h1>

      <aside class="pre-license-banner" role="note" aria-label="Pre-licensure notice">
        <p><strong>Heads up.</strong> I'm a licensed Mississippi real estate salesperson (License #S-62221) with Real Broker, LLC. This page is general information about living on the Coast — not a property-specific opinion, legal or tax advice, or an insurance determination. When you're ready to talk specifics, I'm here to help.</p>
      </aside>

      <p class="lede">Waveland is the Coast's best-kept non-secret: it calls itself "The Hospitality City," and it's the <strong>only community on the Mississippi Gulf Coast that prohibits commercial buildings on its beachfront</strong>. No casinos on the sand, no condo towers, no strip of souvenir shops — just miles of quiet residential beach road. If Bay St. Louis next door is the artsy main-street town, Waveland is where you go when the whole point is the beach and the porch.</p>
    </header>

    {hero.image && (
      <figure class="hero-figure">
        <img src={hero.image} alt={hero.alt} loading="eager" width="1440" height="810" />
      </figure>
    )}

    <section class="guide-section">
      <h2>The town in one paragraph</h2>
      <p>Waveland sits in Hancock County on the far western end of the Coast, sharing a border (and a school district) with Bay St. Louis. It's about an hour from New Orleans, which shapes everything: a meaningful share of buyers are Louisiana second-homers and weekenders, alongside retirees and remote workers who want beach-block living at prices that would be a rounding error in Florida. Beach Boulevard runs the length of the waterfront with houses on one side and sand on the other. The town's history is inseparable from Katrina — Waveland took the storm's worst surge, 27–28 feet, and was essentially erased in 2005. What stands near the water today is almost entirely post-storm, elevated, storm-rated construction. That's not a sad story for a buyer; it's the reason Waveland's beachfront stock is some of the most insurable coastal construction in Mississippi.</p>
    </section>

    <section class="guide-section">
      <h2>The areas of town</h2>
      <p class="section-sub">Waveland splits roughly into the beach blocks, the central Highway 90 corridor, and the higher ground north toward the Kiln. Each carries a different price band and a different flood and insurance profile.</p>

      <div class="zone-grid neighborhood-grid">
        {neighborhoods.map(n => (
          <div class="zone-card">
            {n.image && (
              <div class="zone-card-image">
                <img src={n.image} alt={n.imageAlt} loading="lazy" width="800" height="500" />
              </div>
            )}
            <div class="zone-card-body">
              <div class="zone-code">{n.code}</div>
              <h3>{n.name}</h3>
              <p class="walk-tag">{n.walk}</p>
              <p class="zone-blurb">{n.blurb}</p>
              <p class="zone-detail">{n.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="callout"><strong>On prices.</strong> Directional, mid-2020s — verify against current MLS. Waveland's spread is wide because the stock is: recent data shows median <em>sale</em> prices in the high $100Ks–low $200Ks across the whole town, while the beach-block elevated homes list from roughly <strong>$300K into the $600Ks+</strong>. For open-Gulf-adjacent beach living, that beach-block number is the story — comparable settings in coastal Florida or Alabama run multiples of it.</p>
    </section>

    <section class="guide-section">
      <h2>Schools</h2>
      <p>Waveland shares the <strong>Bay St. Louis-Waveland School District</strong> with Bay St. Louis. Verify current accountability ratings at <a href="https://www.mdek12.org/" target="_blank" rel="noopener">mdek12.org</a> and the attendance zone for any specific address with the district.</p>

      <div class="school-grid">
        {schools.map(s => (
          <div class="school-row">
            <span class="school-level">{s.level}</span>
            <span class="school-name">{s.name}</span>
          </div>
        ))}
      </div>

      <p class="school-note">Coast Episcopal and the Hancock County private/parochial options round out the picture. Verify current programs, grades served, and admissions directly with each school.</p>
    </section>

    <section class="guide-section">
      <h2>Flood profile, in plain terms</h2>
      <p>Hancock County took Katrina's worst — this is where the 27–28 foot surge came ashore. The rebuilt landscape reflects it: BFEs are serious near the water, VE/AE dominates south of the railroad, and elevated pile construction is the norm on the beach blocks.</p>
      <p>Working in your favor: post-2011 elevated builds are the most insurable coastal stock in the state, and X-zone ground genuinely exists in northern Waveland. Pull the FIRM panel at <a href="https://msc.fema.gov" target="_blank" rel="noopener">msc.fema.gov</a> for any address, and read my <a href="/guides/coastal-ms-flood-zones">flood-zone guide</a> before you shop. The three-policy insurance stack applies south of I-10 — budget for it up front.</p>
    </section>

    <section class="guide-section">
      <h2>Market beats every Waveland buyer or seller should hear</h2>
      <p class="section-sub">Stable patterns — not month-to-month price talk. These are the things that come up in every real Waveland conversation.</p>

      <dl class="beats">
        {marketBeats.map(b => (
          <div class="beat">
            <dt>{b.label}</dt>
            <dd>{b.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="guide-section">
      <h2>Day-to-day in Waveland</h2>
      <p>Stuff that's actually here, in case you're trying to picture life on the ground:</p>
      <ul class="bullets">
        <li><strong>The beach:</strong> miles of it, residential-quiet, with parking pull-offs along Beach Boulevard. Calm Sound water.</li>
        <li><strong>Old Town Bay St. Louis:</strong> five minutes away — the restaurants, galleries, marina, and arts walk serve both towns.</li>
        <li><strong>Buccaneer State Park:</strong> in Waveland itself — campground, waterpark, and green space on the beachfront.</li>
        <li><strong>Highway 90 strip:</strong> groceries, hardware, everyday errands.</li>
        <li><strong>Day-trip math:</strong> Bay St. Louis 5 minutes · Diamondhead 15 · Gulfport 30 · New Orleans about an hour · Stennis Space Center (a major west-Coast employer) 20 minutes.</li>
      </ul>
    </section>

    <section class="guide-section">
      <h2>Who tends to buy here</h2>
      <p>The Waveland buyer pool I see breaks down roughly like this:</p>
      <ul class="bullets">
        <li><strong>Louisiana second-homers</strong> — the biggest pipeline.</li>
        <li><strong>Retirees</strong> — often drawn by the quiet beachfront plus Mississippi's retirement-income tax exemption (<a href="/guides/retiring-on-the-ms-gulf-coast">retirement guide</a>).</li>
        <li><strong>Remote workers</strong> trading city rents for beach blocks (<a href="/guides/remote-work-live-on-the-coast">remote-work guide</a>).</li>
        <li><strong>Long-time Coast locals</strong> moving west for value.</li>
      </ul>
    </section>

    <section class="cta-block">
      <h2>Thinking about Waveland?</h2>
      <p>Whether you're comparing it against Bay St. Louis, running STR numbers, or trying to figure out if a beach-block house actually pencils with insurance — happy to talk it through straight.</p>
      <div class="cta-buttons">
        <a href="tel:+12283251502" class="btn btn-primary">Call or text Rob — (228) 325-1502</a>
        <a href="mailto:rob@robrecio.com" class="btn btn-ghost">Email Rob</a>
      </div>
      <p class="cta-note">Rob Recio is a licensed Mississippi real estate salesperson (#S-62221) with Real Broker, LLC. This guide is general information about Waveland as a place to live — not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Sources & cross-links</h3>
      <ul>
        <li>City of Waveland — <a href="https://www.waveland-ms.gov" target="_blank" rel="noopener">waveland-ms.gov</a> (ordinances, STR rules)</li>
        <li>Bay St. Louis-Waveland School District · MDE ratings — <a href="https://www.mdek12.org/" target="_blank" rel="noopener">mdek12.org</a></li>
        <li>FEMA Map Service Center — <a href="https://msc.fema.gov" target="_blank" rel="noopener">msc.fema.gov</a></li>
        <li>Market data: Redfin/Rocket Homes Waveland reports (2025–26)</li>
        <li>Related on this site: <a href="/areas/bay-st-louis">Bay St. Louis guide</a> · <a href="/guides/coastal-ms-flood-zones">Flood zones</a> · <a href="/relocation">Relocation guide</a></li>
      </ul>
      <p class="sources-note"><strong>Drafted July 2026.</strong> Prices, ordinances, ratings change — verify before relying on a number. Next refresh: after 2026–27 accountability ratings.</p>
    </aside>

  </main>

</SiteLayout>

<style>
  .guide {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .guide-hero {
    max-width: var(--max-prose);
    margin: 0 auto 4rem;
    text-align: left;
  }
  .eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gulf);
    margin-bottom: 1.2rem;
  }
  .guide-hero h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 4.8vw, 3.4rem);
    line-height: 1.07;
    letter-spacing: -0.022em;
    color: var(--ink);
  }
  .guide-hero h1 em {
    font-style: italic;
    color: var(--gulf-deep);
  }
  .pre-license-banner {
    margin-top: 1.6rem;
    padding: 1rem 1.3rem;
    background: var(--sand);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
  }
  .pre-license-banner p {
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  .pre-license-banner strong { color: var(--ink); }
  .lede {
    font-size: 1.18rem;
    color: var(--ink-soft);
    margin-top: 1.5rem;
    line-height: 1.6;
  }
  .lede strong { color: var(--ink); }

  .guide-section {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .guide-section h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-bottom: 1.2rem;
  }
  .guide-section p {
    font-size: 1.06rem;
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
    line-height: 1.7;
  }
  .guide-section p:first-of-type { color: var(--ink); }
  .guide-section .section-sub {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-top: -0.4rem;
    margin-bottom: 1.8rem;
  }

  .bullets {
    margin: 0 0 1.2rem 0;
    padding-left: 1.4rem;
    color: var(--ink-soft);
  }
  .bullets li {
    margin-bottom: 0.85rem;
    line-height: 1.65;
  }
  .bullets li strong { color: var(--ink); }

  .callout {
    background: var(--sand);
    border-left: 3px solid var(--gulf);
    padding: 1.1rem 1.3rem;
    border-radius: 0 8px 8px 0;
    font-size: 0.98rem !important;
    color: var(--ink) !important;
    margin-top: 1.2rem;
  }
  .callout strong { color: var(--gulf-deep); }

  /* Hero figure — full prose-max width, just under the lede */
  .hero-figure {
    max-width: var(--max);
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Inline figures — single wide, or 2-up grid */
  .inline-figure {
    margin: 1.5rem 0 0.4rem;
  }
  .inline-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .inline-figure-wide img {
    aspect-ratio: 16 / 9;
  }
  .inline-figure figcaption {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    margin-top: 0.45rem;
    text-align: center;
  }
  .inline-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .inline-pair .inline-figure {
    margin: 0;
  }
  @media (max-width: 640px) {
    .inline-pair { grid-template-columns: 1fr; }
  }

  /* Neighborhood grid — 2-up on desktop, 1-up mobile */
  .neighborhood-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .zone-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .zone-card-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .zone-card-body {
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
  }
  .zone-code {
    display: inline-block;
    background: var(--gulf);
    color: var(--paper);
    font-family: var(--serif);
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 6px;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    margin-bottom: 0.7rem;
    align-self: flex-start;
  }
  .zone-card h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.22rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .walk-tag {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem !important;
    color: var(--gulf-deep) !important;
    margin-bottom: 0.7rem !important;
  }
  .zone-blurb {
    font-size: 0.97rem !important;
    color: var(--ink) !important;
    margin-bottom: 0.7rem !important;
    line-height: 1.55 !important;
  }
  .zone-detail {
    font-size: 0.92rem !important;
    color: var(--ink-soft) !important;
    line-height: 1.55 !important;
    margin-bottom: 0 !important;
  }
  @media (max-width: 760px) {
    .neighborhood-grid { grid-template-columns: 1fr; }
  }

  /* Schools — simple row layout */
  .school-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1.2rem 0 1rem;
    padding: 1.2rem 1.4rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .school-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .school-level {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--gulf);
  }
  .school-name {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .school-note {
    font-size: 0.92rem !important;
    color: var(--ink-soft) !important;
    font-style: italic;
  }
  @media (max-width: 560px) {
    .school-row { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  /* Market beats — definition list */
  .beats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.2rem;
  }
  .beat {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--gulf);
    border-radius: 0 10px 10px 0;
    padding: 1rem 1.3rem;
  }
  .beat dt {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--gulf-deep);
    margin-bottom: 0.3rem;
  }
  .beat dd {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.6;
  }

  .cta-block {
    max-width: var(--max-prose);
    margin: 4rem auto 0;
    padding: 2.5rem 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-align: center;
  }
  .cta-block h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.8rem;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }
  .cta-block p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-buttons {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .cta-note {
    font-size: 0.82rem !important;
    color: var(--ink-soft) !important;
    font-style: italic;
    margin-bottom: 0 !important;
  }

  .sources {
    max-width: var(--max-prose);
    margin: 3rem auto 0;
    padding: 1.6rem 1.8rem;
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .sources h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.8rem;
  }
  .sources ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }
  .sources li {
    font-size: 0.92rem;
    color: var(--ink-soft);
    padding: 0.35rem 0;
    border-bottom: 1px dashed var(--line-strong);
  }
  .sources li:last-child { border-bottom: none; }
  .sources-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    margin: 0;
  }
</style>
