// Keep paths even when null so the shot list stays visible inline as code comments.
const hero = {
  image: null, // '/areas/biloxi/hero.jpg' — Biloxi Lighthouse on US-90 with the Sound behind it, golden hour
  alt: 'The Biloxi Lighthouse on US-90, the Mississippi Sound stretching out behind it.',
};
const galleryLighthouse = {
  image: null, // '/areas/biloxi/lighthouse.jpg' — Biloxi Lighthouse close, the city icon
  alt: 'The Biloxi Lighthouse, the city icon, on US-90 in downtown Biloxi.',
};
const galleryCasinoRow = {
  image: null, // '/areas/biloxi/casino-row.jpg' — Beau Rivage / Hard Rock skyline from the beach side
  alt: 'Casino-row high-rises along the Biloxi waterfront, seen from the beach.',
};
const galleryPointCadet = {
  image: null, // '/areas/biloxi/point-cadet.jpg' — Point Cadet marina at the east tip of the peninsula
  alt: 'The marina at Point Cadet, at the east tip of the Biloxi peninsula.',
};

const neighborhoods = [
  {
    code: 'SOUTH OF THE TRACKS',
    name: 'The peninsula waterfront / casino row',
    walk: 'Walk-to-water, casino-adjacent',
    blurb: 'The beach side of the peninsula, south of the CSX railroad and along US-90 — the Biloxi Lighthouse, the Beau Rivage and Hard Rock anchoring casino row, the Town Green and MGM Park downtown. A mix of pre-Katrina survivors, post-storm elevated rebuilds on pilings, and lots that never came back.',
    detail: 'This is the most flood-exposed part of town: VE on the immediate beachfront, AE through much of the first mile. Katrina leveled the first three to four blocks south of the tracks in 2005 — much of what stands here now is post-2005 construction or empty lot. Mortgage flood insurance required almost everywhere; pile foundations and breakaway-wall rules apply to newer builds. Get a current Elevation Certificate and a flood quote before you fall in love.',
    image: null, // '/areas/biloxi/peninsula-waterfront.jpg' — a US-90 beachfront block or an elevated rebuild on pilings
    imageAlt: 'An elevated home on pilings near the Biloxi beachfront, south of the railroad tracks.',
  },
  {
    code: 'POINT CADET',
    name: 'Point Cadet / the east tip',
    walk: 'Walk-to-marina, casino-adjacent',
    blurb: 'The far east tip of the peninsula — waterfront, the marina, and a short walk from the easternmost casinos. Historically the working seafood end of Biloxi; today a mix of waterfront homes, condos, and redevelopment parcels. Price band runs higher here than most of town because of the water and the casino proximity.',
    detail: 'Heavy coastal flood exposure — VE and AE — and full exposure to named-storm surge off both the Sound and the Back Bay. Insurance is the gating factor on almost every deal out here. If you are looking at the water, budget for three policies (more on that below) before you run the numbers.',
