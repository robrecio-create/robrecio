  .callout {
    background: var(--sand);
    border-left: 3px solid var(--gulf);
    padding: 1.1rem 1.3rem;
    border-radius: 0 8px 8px 0;
    font-size: 0.98rem !important;
    color: var(--ink) !important;
    margin-top: 1.2rem;
  }
  .callout strong { color: var(--gulf-deep); }

  /* Hero figure — full prose-max width, just under the lede */
  .hero-figure {
    max-width: var(--max);
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Inline figures — single wide, or 2-up grid */
