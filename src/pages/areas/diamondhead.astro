    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  .pre-license-banner strong { color: var(--ink); }
  .lede {
    font-size: 1.18rem;
    color: var(--ink-soft);
    margin-top: 1.5rem;
    line-height: 1.6;
  }
  .lede strong { color: var(--ink); }

  .guide-section {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .guide-section h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-bottom: 1.2rem;
  }
  .guide-section p {
    font-size: 1.06rem;
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
    line-height: 1.7;
