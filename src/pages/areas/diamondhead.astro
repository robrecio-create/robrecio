    margin: 1.5rem 0 0.4rem;
  }
  .inline-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .inline-figure-wide img {
