---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const orient = [
  { label: 'Where it is', value: 'Right in the middle of the Mississippi Coast, in Harrison County. Biloxi is about 15 minutes east; Ocean Springs about 25 minutes east across Biloxi Bay; New Orleans roughly 80 minutes west on I-10; Mobile about an hour and a quarter east. The Gulfport-Biloxi airport (GPT) is in town.' },
  { label: 'The waterfront', value: 'Highway 90 runs the beach straight through town, with the sand on one side and the city on the other. Jones Park, the harbor, and the Mississippi Aquarium cluster near where Highway 49 meets Highway 90 — that’s the heart of the visitor side of Gulfport.' },
  { label: 'Size & pace', value: 'About 72,000 people — the second-largest city in Mississippi and the Coast’s commercial hub. It’s a real city with a working port, so it’s busier and more spread out than the smaller Coast towns. A car helps.' },
];
---

<SiteLayout
