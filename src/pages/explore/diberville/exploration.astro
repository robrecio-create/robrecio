---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const outdoors = [
  {
    name: 'Back Bay of Biloxi',
    meta: 'D’Iberville’s south shore · year-round',
    note: 'The Back Bay is the reason to get outside here. It’s a sheltered, productive inshore fishery — redfish, speckled trout, black drum, flounder, and sheepshead — and it’s right at the edge of town. Whether you launch your own boat, book a charter, or just fish from shore, this is the headline outdoor experience in D’Iberville.',
  },
  {
    name: 'Public boat launch & marina',
    meta: 'Riverside · city facility',
    note: 'D’Iberville maintains a public boat launch and marina giving direct access to the Back Bay. It’s the easy way onto the water if you’re trailering a boat. Confirm current launch fees and ramp conditions with the city before you haul out.',
  },
  {
    name: 'Riverside Kayak Launch',
    meta: 'Riverside · paddle access',
    note: 'A dedicated kayak launch for getting onto the calmer back waters under your own power. Bring your own boat; the bay’s sheltered side is forgiving for paddlers who keep an eye on wind and tide.',
  },
  {
    name: 'Fountain Pier',
    meta: 'Waterfront · fishing pier',
    note: 'A public fishing pier with finger piers, wash stations, grills, and picnic areas — a low-effort way to fish or just sit on the bay. Good for families and for anyone who wants the water without a boat.',
  },
  {
    name: 'Back Bay charters',
    meta: 'Guided · half & full day',
    note: 'Several inshore guides run out of the Back Bay and surrounding waters. If you don’t have a boat or local knowledge, a half-day charter is the fastest route to fish. Book ahead, confirm pricing, and check the weather — trips depend on it.',
  },
];

const daytrips = [
  { name: 'Biloxi', meta: '~5–10 min south', note: 'The closest big draw — straight across the I-110 bridge. Casinos, the Biloxi Lighthouse, the beach, and the Maritime & Seafood Industry Museum if you want to understand shrimping.' },
  { name: 'Ocean Springs', meta: '~15 min east', note: 'The Coast’s walkable art town — galleries, the Walter Anderson Museum, and Davis Bayou in the Gulf Islands National Seashore. An easy, scenic counterpoint to D’Iberville’s practicality.' },
  { name: 'Gulfport', meta: '~15 min west', note: 'More beach, the harbor, and the Mississippi Aquarium — a solid family day a short hop down I-10.' },
  { name: 'New Orleans', meta: '~90 min west', note: 'You know what’s there. An easy day trip or overnight straight down I-10 from D’Iberville’s central spot.' },
];
---

<SiteLayout
  title="Exploring D’Iberville — The Back Bay, Fishing & Day Trips | Rob Recio"
  description="The outdoors guide to D’Iberville, Mississippi — Back Bay of Biloxi fishing, the public boat launch and kayak launch, Fountain Pier, and easy day trips to Biloxi, Ocean Springs, and beyond."
  robots="noindex, nofollow, noarchive, nosnippet"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow"><a href="/explore" class="crumb">Explore</a> · <a href="/explore/diberville" class="crumb">D’Iberville</a> · Exploration</p>
      <h1>Getting outside in D’Iberville <em>— and what’s a short drive away.</em></h1>
      <p class="lede">The Back Bay is D’Iberville&rsquo;s real outdoor draw, and the fishing here is genuinely good. Beyond that, the town&rsquo;s biggest outdoor advantage is its location — everywhere worth exploring on the Coast is a few minutes off. Here&rsquo;s how to get on the water, and where to go from here.</p>
    </header>

    <section class="guide-section">
      <h2>On the Back Bay</h2>
      <p class="section-sub">D’Iberville’s waterfront, in order of how easy it is to get onto the water.</p>
      <div class="place-list">
        {outdoors.map(o => (
          <div class="place">
            <div class="place-head">
              <h3>{o.name}</h3>
              <span class="place-meta">{o.meta}</span>
            </div>
            <p>{o.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>Day trips from D’Iberville</h2>
      <p class="section-sub">The best thing about basing here: everything else on the Coast is a short drive.</p>
      <div class="place-list">
        {daytrips.map(d => (
          <div class="place">
            <div class="place-head">
              <h3>{d.name}</h3>
              <span class="place-meta">{d.meta}</span>
            </div>
            <p>{d.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>A perfect outdoor day</h2>
      <p>Early morning on the Back Bay — your own boat, a charter, or a line off Fountain Pier while the water&rsquo;s still calm. A po-boy from Quave Brothers for lunch. Then point the car wherever the day calls for: Biloxi&rsquo;s beach across the bridge, Ocean Springs&rsquo; galleries to the east, or Gulfport&rsquo;s harbor to the west. That&rsquo;s D’Iberville at its best — a central launchpad with a great little fishery attached. When you&rsquo;re ready to eat, the <a href="/explore/diberville/food-and-dining">food guide</a> has the rest.</p>
    </section>

    <section class="cta-block">
      <h2>Exploring the whole Coast?</h2>
      <p>I cover the outdoors, the water, and the events across all three counties in <strong>The Seawall</strong>, my twice-weekly newsletter. More town Exploration guides going up here as I write them.</p>
      <div class="cta-buttons">
        <a href="/explore" class="btn btn-primary">All Coast guides</a>
        <a href="mailto:robrecio@gmail.com" class="btn btn-ghost">Ask Rob</a>
      </div>
      <p class="cta-note">Rob Recio lives in Ocean Springs and is in real-estate-licensure training in Mississippi. This is informational visitor content, not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Sources</h3>
      <ul>
        <li>City of D’Iberville — Parks & Recreation (boat launch, kayak launch, Fountain Pier) — <a href="https://diberville.ms.us/departments/parks-recreation/" target="_blank" rel="noopener">diberville.ms.us/departments/parks-recreation</a></li>
      </ul>
      <p class="sources-note"><strong>Verified May 2026.</strong> Boat-launch fees, ramp and pier conditions, and charter pricing change — confirm with the city or your charter operator before you go. Fishing licenses are required; check Mississippi DMR rules. All trips on the water depend on weather and tide.</p>
    </aside>

  </main>

</SiteLayout>

<style>
