    font-family: var(--serif); font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem); line-height: 1.15;
    letter-spacing: -0.018em; color: var(--ink); margin-bottom: 0.6rem;
  }
  .section-sub { color: var(--ink-soft); font-size: 1.05rem; margin-bottom: 1.6rem; line-height: 1.6; }
  .guide-section > p { font-size: 1.06rem; color: var(--ink-soft); line-height: 1.7; margin-bottom: 1.1rem; }

  .place-list { display: flex; flex-direction: column; gap: 0.8rem; }
