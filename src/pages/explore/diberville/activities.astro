---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const things = [
  {
    name: 'The Promenade',
    meta: 'Promenade Pkwy · the anchor',
    note: 'A 700,000-square-foot open-air shopping center with 45-plus stores — Target, Best Buy, Dick’s Sporting Goods, Belk, Marshalls, Michael’s, ULTA, and more — plus a row of restaurants. This is where the whole Coast comes to shop. Not glamorous, but genuinely useful, and the reason a lot of people drive to D’Iberville at all.',
  },
  {
    name: 'Scarlet Pearl Casino Resort',
    meta: 'Central Ave · casino & hotel',
    note: 'D’Iberville’s own casino resort — gaming floor, hotel, restaurants, and a spot to land for a value-priced night a few minutes from everything. Hours and offerings change, so check the resort directly before you plan around a show or a specific restaurant.',
  },
  {
    name: 'Lava Links at Scarlet Pearl',
    meta: 'Central Ave · mini golf',
    note: 'A 36-hole miniature golf course built around an erupting volcano, with waterfalls, footbridges, and gardens. Genuinely fun with kids, and an easy add-on to a casino-resort stay. Confirm seasonal hours before you go.',
  },
  {
    name: 'D’Iberville Farmers Market',
    meta: 'Town Green · Saturday mornings',
    note: 'Year-round under the outdoor pavilion on Central Avenue, Saturday mornings 9 a.m.–2 p.m. Local produce and vendors, low-key and friendly. A nice, free way to start a Saturday before the shopping.',
  },
  {
    name: 'Fishing the Back Bay',
    meta: 'Back Bay of Biloxi · year-round',
    note: 'This is the thing D’Iberville is genuinely known for. The Back Bay is some of the most productive inshore water on the Coast — redfish, speckled trout, black drum, flounder, sheepshead. Local charters launch from here; more on the how-to in the Exploration guide.',
  },
];
---

<SiteLayout
  title="Things to Do in D’Iberville, MS — Shopping, Casino & Fishing | Rob Recio"
  description="What to actually do in D’Iberville, Mississippi — the Promenade shopping center, Scarlet Pearl Casino and Lava Links mini golf, the Saturday farmer’s market, and Back Bay fishing."
  robots="noindex, nofollow, noarchive, nosnippet"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow"><a href="/explore" class="crumb">Explore</a> · <a href="/explore/diberville" class="crumb">D’Iberville</a> · Activities</p>
      <h1>Things to do in D’Iberville, <em>without overselling it.</em></h1>
      <p class="lede">D’Iberville isn&rsquo;t loaded with marquee attractions — and I&rsquo;m not going to pretend otherwise. What it has is practical: the Coast&rsquo;s biggest shopping center, a casino resort, a fun mini-golf course, and some of the best inshore fishing around. This guide covers in-town activities; the <a href="/explore/diberville/exploration">Exploration guide</a> handles the water and the day trips across the bay.</p>
    </header>

    <section class="guide-section">
      <h2>Start here</h2>
      <p class="section-sub">The handful of things that actually make D’Iberville worth a stop.</p>
      <div class="place-list">
        {things.map(t => (
          <div class="place">
            <div class="place-head">
              <h3>{t.name}</h3>
              <span class="place-meta">{t.meta}</span>
            </div>
            <p>{t.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>The vibe</h2>
      <p>D’Iberville is a get-things-done kind of town: shop, eat, fish, sleep, and use it as a launchpad for everywhere else. Don&rsquo;t build a whole vacation around it — build a smart, central base out of it. Knock out the shopping, throw a line in the Back Bay, and let Biloxi and Ocean Springs handle the sightseeing. Hungry? The <a href="/explore/diberville/food-and-dining">food guide</a> is next door.</p>
    </section>

    <section class="cta-block">
      <h2>Looking for what’s on this week?</h2>
      <p>Events, live music, festivals, and openings across Harrison, Jackson, and Hancock counties go out twice a week in <strong>The Seawall</strong>, my Coast newsletter.</p>
      <div class="cta-buttons">
        <a href="/explore/diberville" class="btn btn-primary">More D’Iberville guides</a>
        <a href="mailto:robrecio@gmail.com" class="btn btn-ghost">Ask Rob</a>
      </div>
      <p class="cta-note">Rob Recio lives in Ocean Springs and is in real-estate-licensure training in Mississippi. This is informational visitor content, not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Good to know</h3>
      <p class="sources-note"><strong>Verified May 2026.</strong> Casino, mini-golf, and farmer’s-market hours are seasonal and can shift — confirm before you plan around them. Promenade tenant list and hours are on <a href="https://www.coastalmississippi.com/directory/promenade-diberville/" target="_blank" rel="noopener">Coastal Mississippi</a>; resort details on the <a href="https://www.scarletpearlcasino.com" target="_blank" rel="noopener">Scarlet Pearl site</a>.</p>
    </aside>

  </main>

</SiteLayout>

<style>
