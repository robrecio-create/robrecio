---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const things = [
  {
    name: 'Biloxi Lighthouse',
    meta: 'Hwy 90 · the city’s icon',
    note: 'Erected in 1848, one of the first cast-iron lighthouses in the South, and the city’s signature landmark — it stands in the median of Highway 90, which makes for one of the more unusual lighthouse settings anywhere. Tours climb the tower most mornings, weather permitting. After Katrina it became the symbol of the city coming back. Start here.',
  },
  {
    name: 'Maritime & Seafood Industry Museum',
    meta: 'Point Cadet · the heritage anchor',
    note: 'The best place to understand why Biloxi exists. Exhibits on shrimping, oystering, wooden boat building, net-making, and the catboats and skiffs that worked these waters — the only museum of its kind on the Gulf. Out front sit the museum’s two replica Biloxi schooners. An easy, worthwhile hour.',
  },
  {
    name: 'Sail a Biloxi schooner',
    meta: 'Glenn L. Swetman & Mike Sekul · seasonal',
    note: 'The Maritime Museum runs two 65-foot replica two-masted schooners out of Point Cadet. Public day sails go out in season, and they’re available for charter. It’s the same kind of boat that worked these waters for two centuries — a genuinely good way to get on the Sound. Schedules depend on weather and season, so book ahead.',
  },
  {
    name: 'Ohr-O’Keefe Museum of Art',
    meta: 'Beach Blvd · the Frank Gehry building',
    note: 'A campus of swooping, metal-clad buildings designed by Frank Gehry to "dance" around the live oaks on the site — worth seeing for the architecture alone. Inside is the work of George Ohr, the self-proclaimed "Mad Potter of Biloxi," whose wild, warped ceramics were a century ahead of their time. Quietly one of the best art stops on the Coast.',
  },
  {
    name: 'Biloxi Town Green',
    meta: 'Downtown · Beach Blvd',
    note: 'An open green under live oaks in the heart of downtown, home to the Hurricane Katrina Memorial and a regular roster of festivals, concerts, and craft fairs. Check what’s on when you’re in town — the seafood and music events here are a good time. (The Seawall is the easy way to catch the schedule.)',
  },
  {
    name: 'The casino resorts',
    meta: 'Beach Blvd strip',
    note: 'Whatever your feelings on gaming, the resorts — Beau Rivage, Hard Rock, IP, Golden Nugget, Palace, and more — are the engine of modern Biloxi, and they bring big-name concerts, spas, pools, and serious restaurants. Even if you never touch a slot machine, a resort can be a comfortable, walkable base right on the beach.',
  },
];
---

<SiteLayout
  title="Things to Do in Biloxi, MS — A Coast Local’s Guide | Rob Recio"
  description="What to actually do in Biloxi, Mississippi — the 1848 lighthouse, the Maritime & Seafood Industry Museum and its schooners, the Frank Gehry–designed Ohr-O’Keefe, the Town Green, and the casinos."
  robots="noindex, nofollow, noarchive, nosnippet"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow"><a href="/explore" class="crumb">Explore</a> · <a href="/explore/biloxi" class="crumb">Biloxi</a> · Activities</p>
      <h1>Things to do in Biloxi, <em>beyond the gaming floor.</em></h1>
      <p class="lede">Biloxi is best known for its casinos, and they&rsquo;re a real draw — concerts, pools, restaurants, all on the beach. But the city has a lot more going for it: a cast-iron lighthouse older than the Civil War, a seafood museum that explains the whole Coast, and a Frank Gehry art campus most visitors never find. This guide covers what to do in town; the <a href="/explore/biloxi/exploration">Exploration guide</a> handles the beach, Deer Island, and day trips.</p>
    </header>

    <section class="guide-section">
      <h2>Start here</h2>
      <p class="section-sub">The six things I&rsquo;d make sure a first-time visitor hit.</p>
      <div class="place-list">
        {things.map(t => (
          <div class="place">
            <div class="place-head">
              <h3>{t.name}</h3>
              <span class="place-meta">{t.meta}</span>
            </div>
            <p>{t.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>The vibe</h2>
      <p>Biloxi runs hotter than the quieter Coast towns — the casino strip keeps it lively day and night, and there&rsquo;s always something on at the Town Green or in a resort showroom. The trick is to mix it: an afternoon of history and museums, an evening of resort dining or a concert, and a morning on the beach or the water. Pick two or three of the above, leave room to wander downtown and the harbor, and you&rsquo;ve got Biloxi right. Hungry? The <a href="/explore/biloxi/food-and-dining">food guide</a> is next door.</p>
    </section>

    <section class="cta-block">
      <h2>Looking for what’s on this week?</h2>
      <p>Concerts, festivals, gallery openings, and events across Jackson, Harrison, and Hancock counties go out twice a week in <strong>The Seawall</strong>, my Coast newsletter.</p>
      <div class="cta-buttons">
        <a href="/explore/biloxi" class="btn btn-primary">More Biloxi guides</a>
        <a href="mailto:robrecio@gmail.com" class="btn btn-ghost">Ask Rob</a>
      </div>
      <p class="cta-note">Rob Recio lives in Ocean Springs and is in real-estate-licensure training in Mississippi. This is informational visitor content, not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Good to know</h3>
      <p class="sources-note"><strong>Verified May 2026.</strong> Lighthouse climbs and schooner sails depend on weather and season — confirm before you plan around them. Museum hours and admission are on the <a href="https://www.maritimemuseum.org" target="_blank" rel="noopener">Maritime &amp; Seafood Industry Museum</a> and <a href="https://georgeohr.org" target="_blank" rel="noopener">Ohr-O&rsquo;Keefe</a> sites.</p>
    </aside>

  </main>

</SiteLayout>

