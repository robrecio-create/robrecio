---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const outdoors = [
  {
    name: 'Biloxi Beach',
    meta: 'Along Hwy 90 · free parking',
    note: 'A wide white-sand beach runs the length of the waterfront — part of a 26-mile man-made stretch built along the Coast after the 1947 hurricane, often called the longest man-made beach in the world. This is the Mississippi Sound, not the open Gulf, so the water is calm and shallow — great for wading, picnicking, and sunsets. Parking along Highway 90 is free.',
  },
  {
    name: 'Deer Island',
    meta: 'Under a mile offshore · kayak',
    note: 'An undeveloped island sitting just off downtown — beaches, marsh, and pine, with dolphins and shorebirds around it. It’s a short, beginner-friendly paddle when conditions are calm, and a few local outfitters run guided trips if you don’t have your own kayak. Bring everything you need; there are no facilities out there.',
  },
  {
    name: 'Biloxi Small Craft Harbor & Point Cadet',
    meta: 'East end · the working waterfront',
    note: 'The east-end harbor is the working heart of old Biloxi — shrimp and charter boats, the schooner pier, McElroy’s for a fried platter with a view. A good place to walk, watch the boats, and feel the seafood town under the casino town. Charter fishing trips push off from here too.',
  },
  {
    name: 'Sunset on the Sound',
    meta: 'The beach · the harbor · the lighthouse',
    note: 'The whole beachfront faces south over the Sound, and the long flat horizon makes for big, easy sunsets. The beach off Highway 90 is the simplest spot; the harbor and the lighthouse at dusk are the photographers’ picks.',
  },
];

const daytrips = [
  { name: 'Ocean Springs', meta: '15 min east', note: 'A walkable art town across the bay bridge — galleries, the Walter Anderson Museum, great food, and Davis Bayou in the Gulf Islands National Seashore. The quieter counterpoint to Biloxi.' },
  { name: 'Gulfport', meta: '15 min west', note: 'Biloxi’s bigger neighbor — a working port, more beach, the Mississippi Aquarium, and Ship Island ferries that run in season out to the barrier islands.' },
  { name: 'Mobile, AL', meta: '1 hr east', note: 'Bigger city, deep Mardi Gras history (it started here, not New Orleans), and the USS Alabama battleship.' },
  { name: 'New Orleans', meta: '90 min west', note: 'You know what’s there. Easy day trip or overnight straight down I-10.' },
];
---

<SiteLayout
  title="Exploring Biloxi — Beaches, Deer Island & Day Trips | Rob Recio"
  description="The outdoors guide to Biloxi, Mississippi — the 26-mile man-made beach, Deer Island by kayak, Point Cadet and the Small Craft Harbor, sunsets on the Sound, and easy day trips up and down the Coast."
  robots="noindex, nofollow, noarchive, nosnippet"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow"><a href="/explore" class="crumb">Explore</a> · <a href="/explore/biloxi" class="crumb">Biloxi</a> · Exploration</p>
      <h1>Getting outside in Biloxi <em>— and what&rsquo;s a short drive away.</em></h1>
      <p class="lede">Behind the casinos, Biloxi is a beach-and-water town. The long man-made beach, an undeveloped island barely offshore, and a working harbor are all easy to reach. Here&rsquo;s where to get into it — plus the day trips that make Biloxi a solid base for the wider Coast.</p>
    </header>

    <section class="guide-section">
      <h2>On the water & on the sand</h2>
      <p class="section-sub">In-town nature, in order of how easy it is to get to.</p>
      <div class="place-list">
        {outdoors.map(o => (
          <div class="place">
            <div class="place-head">
              <h3>{o.name}</h3>
              <span class="place-meta">{o.meta}</span>
            </div>
            <p>{o.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>Day trips from Biloxi</h2>
      <p class="section-sub">One of the best things about basing here: everywhere else on the Coast is a short drive.</p>
      <div class="place-list">
        {daytrips.map(d => (
          <div class="place">
            <div class="place-head">
              <h3>{d.name}</h3>
              <span class="place-meta">{d.meta}</span>
            </div>
            <p>{d.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>A perfect outdoor day</h2>
      <p>An early walk on the beach before it heats up, a calm-morning paddle out to Deer Island, lunch at McElroy&rsquo;s on the Small Craft Harbor watching the boats, an afternoon at the Maritime Museum or out on a schooner, and sunset on the Sound from the lighthouse end of the beach. That&rsquo;s a Biloxi day that has almost nothing to do with the casinos and everything to do with why the town is here. When you&rsquo;re ready to eat, the <a href="/explore/biloxi/food-and-dining">food guide</a> has the rest.</p>
    </section>

    <section class="cta-block">
      <h2>Exploring the whole Coast?</h2>
      <p>I cover the outdoors, the water, and the events across all three counties in <strong>The Seawall</strong>, my twice-weekly newsletter. More town Exploration guides going up here as I write them.</p>
      <div class="cta-buttons">
        <a href="/explore" class="btn btn-primary">All Coast guides</a>
        <a href="mailto:robrecio@gmail.com" class="btn btn-ghost">Ask Rob</a>
      </div>
      <p class="cta-note">Rob Recio lives in Ocean Springs and is in real-estate-licensure training in Mississippi. This is informational visitor content, not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Sources</h3>
      <ul>
        <li>City of Biloxi — visitor info — <a href="https://biloxi.ms.us/visitor-info/" target="_blank" rel="noopener">biloxi.ms.us/visitor-info</a></li>
        <li>Coastal Mississippi — <a href="https://www.coastalmississippi.com" target="_blank" rel="noopener">coastalmississippi.com</a></li>
      </ul>
      <p class="sources-note"><strong>Verified May 2026.</strong> Deer Island is undeveloped and weather-dependent — only paddle out in calm conditions or with a licensed guide, and bring everything you need. Beach and harbor details change; confirm before you go.</p>
    </aside>

  </main>

</SiteLayout>

<style>
