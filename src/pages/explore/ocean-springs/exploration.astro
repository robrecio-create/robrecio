---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const outdoors = [
  {
    name: 'Gulf Islands National Seashore — Davis Bayou',
    meta: 'In town · national park unit',
    note: 'A piece of a federal park right inside city limits, and most visitors never find it. Marsh hiking trails, a fishing pier, a boat launch, and kayak access. Free to walk; about $25 for an annual pass if you’ll launch a boat regularly. The visitor center is a good first stop.',
  },
  {
    name: 'Front Beach',
    meta: 'South of downtown',
    note: 'Small and calm — this is the Mississippi Sound, not the open Gulf, so the water is gentler and murkier by design. Perfect for wading, a picnic, and watching the sunset. Don’t come expecting Panama City surf; come for the quiet.',
  },
  {
    name: 'Horn Island',
    meta: '12 miles offshore · boat required',
    note: 'Completely undeveloped barrier island — no facilities, often no people. You need a boat (or a charter) to get there, and camping is allowed. This is where Walter Anderson rowed out to paint. If you can arrange the trip, it’s genuinely wild.',
  },
  {
    name: 'Sunset on the water',
    meta: 'Front Beach · the harbor · the bridge',
    note: 'The bayfront faces west, so golden hour is the everyday show. Front Beach and the Inner Harbor are the easy picks; the Biloxi Bay bridge at blue hour is the photographer’s pick.',
  },
];

const daytrips = [
  { name: 'Biloxi', meta: '15 min west', note: 'Casinos, the Biloxi Lighthouse, the Maritime & Seafood Industry Museum (great if you want to understand shrimping), and more beach access.' },
  { name: 'Mobile, AL', meta: '1 hr east', note: 'Bigger city, deep Mardi Gras history (it started here, not New Orleans), and the USS Alabama battleship.' },
  { name: 'New Orleans', meta: '90 min west', note: 'You know what’s there. Easy day trip or overnight straight down I-10.' },
  { name: 'Pascagoula', meta: '20 min east', note: 'The Singing River, the Round Island Lighthouse, and a working shipbuilding coast — a quieter, less-touristed direction.' },
];
---

<SiteLayout
  title="Exploring Ocean Springs — Outdoors, Beaches & Day Trips | Rob Recio"
  description="The outdoors guide to Ocean Springs, Mississippi — Davis Bayou and Gulf Islands National Seashore, Front Beach, Horn Island, sunsets, and easy day trips up and down the Coast."
  robots="index, follow"
>

  <main class="guide">

    <header class="guide-hero">
      <p class="eyebrow"><a href="/explore" class="crumb">Explore</a> · <a href="/explore/ocean-springs" class="crumb">Ocean Springs</a> · Exploration</p>
      <h1>Getting outside in Ocean Springs <em>— and what’s a short drive away.</em></h1>
      <p class="lede">The water and the marsh are the whole reason this town feels the way it does. Here&rsquo;s where to get into it — plus the day trips that make Ocean Springs a great base for the wider Coast.</p>
    </header>

    <section class="guide-section">
      <h2>On the water & in the marsh</h2>
      <p class="section-sub">In-town nature, in order of how easy it is to get to.</p>
      <div class="place-list">
        {outdoors.map(o => (
          <div class="place">
            <div class="place-head">
              <h3>{o.name}</h3>
              <span class="place-meta">{o.meta}</span>
            </div>
            <p>{o.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>Day trips from Ocean Springs</h2>
      <p class="section-sub">One of the best things about basing here: everywhere else on the Coast is a short drive.</p>
      <div class="place-list">
        {daytrips.map(d => (
          <div class="place">
            <div class="place-head">
              <h3>{d.name}</h3>
              <span class="place-meta">{d.meta}</span>
            </div>
            <p>{d.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="guide-section">
      <h2>A perfect outdoor day</h2>
      <p>Coffee and donuts downtown, an early walk on the Davis Bayou marsh trails before it heats up, lunch from Government Street Grocery eaten on the harbor seawall, an afternoon biking the beach road, and sunset at Front Beach. That&rsquo;s an Ocean Springs day that costs almost nothing and beats most paid attractions. When you&rsquo;re ready to eat, the <a href="/explore/ocean-springs/food-and-dining">food guide</a> has the rest.</p>
    </section>

    <section class="cta-block">
      <h2>Exploring the whole Coast?</h2>
      <p>I cover the outdoors, the water, and the events across all three counties in <strong>The Seawall</strong>, my twice-weekly newsletter. More town Exploration guides going up here as I write them.</p>
      <div class="cta-buttons">
        <a href="/explore" class="btn btn-primary">All Coast guides</a>
        <a href="mailto:rob@robrecio.com" class="btn btn-ghost">Ask Rob</a>
      </div>
      <p class="cta-note">Rob Recio lives in Ocean Springs and is a licensed Mississippi real estate salesperson (#S-62221) with Real Broker, LLC. This is informational visitor content, not real-estate advice or a solicitation.</p>
    </section>

    <aside class="sources">
      <h3>Sources</h3>
      <ul>
        <li>Gulf Islands National Seashore — Davis Bayou — <a href="https://www.nps.gov/guis" target="_blank" rel="noopener">nps.gov/guis</a></li>
      </ul>
      <p class="sources-note"><strong>Verified May 2026.</strong> Park hours, fees, and boat-launch/pass details are set by the National Park Service and change — confirm at nps.gov/guis before you go. Horn Island access depends on weather and your own boat or a licensed charter.</p>
    </aside>

  </main>

</SiteLayout>

<style>
  .guide { max-width: var(--max); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
  .guide-hero { max-width: var(--max-prose); margin: 0 auto 3rem; text-align: left; }
  .eyebrow {
    font-size: 0.78rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--gulf); margin-bottom: 1.2rem;
  }
  .crumb { color: var(--gulf); text-decoration: none; }
  .crumb:hover { text-decoration: underline; }
  .guide-hero h1 {
    font-family: var(--serif); font-weight: 600;
    font-size: clamp(2.25rem, 4.8vw, 3.4rem); line-height: 1.07;
    letter-spacing: -0.022em; color: var(--ink);
  }
  .guide-hero h1 em { font-style: italic; color: var(--gulf-deep); }
  .lede { font-size: 1.18rem; color: var(--ink-soft); margin-top: 1.5rem; line-height: 1.6; }

  .guide-section { max-width: var(--max-prose); margin: 0 auto; padding: 2.5rem 0; border-top: 1px solid var(--line); }
  .guide-section h2 {
    font-family: var(--serif); font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem); line-height: 1.15;
    letter-spacing: -0.018em; color: var(--ink); margin-bottom: 0.6rem;
  }
  .section-sub { color: var(--ink-soft); font-size: 1.05rem; margin-bottom: 1.6rem; line-height: 1.6; }
  .guide-section > p { font-size: 1.06rem; color: var(--ink-soft); line-height: 1.7; margin-bottom: 1.1rem; }
  .guide-section > p:first-of-type { color: var(--ink); }

  .place-list { display: flex; flex-direction: column; gap: 0.8rem; }
  .place {
    background: var(--paper); border: 1px solid var(--line);
    border-left: 3px solid var(--gulf); border-radius: 0 10px 10px 0;
    padding: 1.1rem 1.3rem;
  }
  .place-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  .place h3 { font-family: var(--serif); font-weight: 600; font-size: 1.18rem; color: var(--ink); }
  .place-meta { font-size: 0.8rem; color: var(--gulf-deep); font-weight: 500; text-align: right; }
  .place p { font-size: 0.97rem; color: var(--ink-soft); line-height: 1.6; margin: 0; }

  .cta-block {
    max-width: var(--max-prose); margin: 4rem auto 0; padding: 2.5rem 2rem;
    background: var(--paper); border: 1px solid var(--line); border-radius: 14px; text-align: center;
  }
  .cta-block h2 { font-family: var(--serif); font-weight: 600; font-size: 1.8rem; color: var(--ink); margin-bottom: 0.8rem; }
  .cta-block p { color: var(--ink-soft); font-size: 1.05rem; margin: 0 auto 1.5rem; max-width: 600px; }
  .cta-block p strong { color: var(--ink); }
  .cta-buttons { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .cta-note { font-size: 0.82rem !important; color: var(--ink-soft) !important; font-style: italic; margin-bottom: 0 !important; }

  .sources {
    max-width: var(--max-prose); margin: 2.5rem auto 0; padding: 1.4rem 1.6rem;
    background: var(--sand); border: 1px solid var(--line); border-radius: 12px;
  }
  .sources h3 {
    font-family: var(--serif); font-weight: 600; font-size: 1rem; color: var(--ink);
    text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.6rem;
  }
  .sources ul { list-style: none; padding: 0; margin-bottom: 0.8rem; }
  .sources li { font-size: 0.9rem; color: var(--ink-soft); padding: 0.3rem 0; border-bottom: 1px dashed var(--line-strong); }
  .sources li:last-child { border-bottom: none; }
  .sources-note { font-size: 0.88rem; color: var(--ink-soft); font-style: italic; margin: 0; line-height: 1.6; }
</style>
