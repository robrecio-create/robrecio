---
const sites = [
  {
    name: "Jackson County MS Connect",
    url: "https://www.jacksoncountyms.com",
    description: "Local business directories for the Mississippi Gulf Coast — Jackson, Harrison & Hancock counties.",
    preview: "/previews/jacksoncountyms.com.jpg",
  },
  {
    name: "SudsyCo Rentals",
    url: "https://www.sudsycorentals.com",
    description: "Washer & dryer rentals delivered to your door on the Gulf Coast.",
    preview: "/previews/sudsycorentals.com.jpg",
  },
  {
    name: "MapPulse Agency",
    url: "https://www.mappulse.agency",
    description: "Gulf Coast local SEO agency helping businesses rank in Google Maps.",
    preview: "/previews/mappulse.agency.jpg",
  },
  {
    name: "US County Directory",
    url: "https://www.uscountydirectory.com",
    description: "Nationwide local business directory organized by county.",
    preview: "/previews/uscountydirectory.com.jpg",
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Rob Recio — Gulf Coast entrepreneur. Founder of SudsyCo Rentals, MapPulse Agency, and county business directories." />
  <title>Rob Recio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <main>
    <header>
      <div class="name-block">
        <h1>Rob Recio</h1>
        <p class="tagline">Builder. Gulf Coast.</p>
      </div>
      <div class="contact">
        <a href="tel:2282576001">228-257-6001</a>
        <span class="divider">·</span>
        <a href="mailto:robrecio@gmail.com">robrecio@gmail.com</a>
      </div>
    </header>

    <section class="grid">
      {sites.map(site => (
        <a href={site.url} target="_blank" rel="noopener" class="card">
          <div class="preview">
            <img src={site.preview} alt={`${site.name} homepage`} loading="lazy" />
          </div>
          <div class="card-body">
            <h2>{site.name}</h2>
            <p>{site.description}</p>
            <span class="link-label">{site.url.replace('https://www.', '')} →</span>
          </div>
        </a>
      ))}
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Rob Recio</p>
  </footer>

</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --black: #0a0a0a;
    --white: #ffffff;
    --gray-100: #f5f5f5;
    --gray-200: #e5e5e5;
    --gray-500: #737373;
    --gray-800: #262626;
    --accent: #0ea5e9;
    --radius: 12px;
  }

  html { font-size: 16px; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--white);
    color: var(--black);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    width: 100%;
  }

  /* Header */
  header {
    margin-bottom: 4rem;
  }

  .name-block {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--black);
  }

  .tagline {
    font-size: 1rem;
    color: var(--gray-500);
    font-weight: 400;
    margin-top: 0.4rem;
    letter-spacing: 0.02em;
  }

  .contact {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  .contact a {
    font-size: 0.9375rem;
    color: var(--gray-800);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--gray-200);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .contact a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .divider {
    color: var(--gray-200);
    font-size: 1.1rem;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    main {
      padding: 2rem 1.25rem 1rem;
    }

    header {
      margin-bottom: 2rem;
    }

    h1 {
      font-size: 2.25rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .preview {
      display: none;
    }

    .card-body {
      padding: 1rem 1rem 1.125rem;
    }

    .card-body p {
      display: none;
    }

    .link-label {
      margin-top: 0.25rem;
    }
  }

  /* Card */
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
    background: var(--white);
  }

  .card:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    transform: translateY(-3px);
    border-color: var(--gray-200);
  }

  .preview {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--gray-100);
    border-bottom: 1px solid var(--gray-200);
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.4s ease;
  }

  .card:hover .preview img {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-body h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.01em;
  }

  .card-body p {
    font-size: 0.875rem;
    color: var(--gray-500);
    line-height: 1.5;
    flex: 1;
  }

  .link-label {
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.5rem;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Footer */
  footer {
    text-align: center;
    padding: 2rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--gray-500);
    border-top: 1px solid var(--gray-100);
  }
</style>
