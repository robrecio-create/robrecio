    margin-left: auto;
    margin-right: auto;
  }
  .cta-buttons {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .cta-note {
    font-size: 0.82rem !important;
    color: var(--ink-soft) !important;
    font-style: italic;
    margin-bottom: 0 !important;
  }

  .sources {
    max-width: var(--max-prose);
    margin: 3rem auto 0;
    padding: 1.4rem 1.6rem;
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .sources h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.6rem;
  }
  .sources p {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
</style>
